# 1. Deshabilitar listado de directorios
Options -Indexes

# 2. Bloquear ejecución de scripts (Solo bloquea los ejecutables, NO toca css/js/imágenes)
<FilesMatch "\.(php|php5|php7|php8|phtml|cgi|pl|py|sh)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order Deny,Allow
        Deny from all
    </IfModule>
</FilesMatch>